<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta name="color-scheme" content="light dark" />
<link rel="icon" href="data:," />
<title>Source Labs Ai — X Automation Bot</title>
<meta name="description" content="X Automation Bot by Source Labs Ai — an advanced AI reply engine for X (Twitter) that runs as a Chrome extension. Grab the launch offer: complete the Facebook conditions and claim 7 days of full access, free." />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700;800;900&family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet" />
<style>
  :root{
    --ink:#0B0A08;
    --cream:#F4EEE1;
    --cream-dim:#CFC6B2;
    --red:#FF4B1F;
    --red-dark:#D93A12;
    --yellow:#F2C94C;
    --green:#3ECF6B;
    --bg:#0B0A08;
    --bg-2:#14120E;
    --surface:rgba(244,238,225,.045);
    --surface-strong:rgba(244,238,225,.08);
    --line:rgba(244,238,225,.14);
    --text:#F4EEE1;
    --muted:#B9B09A;
    --card-shadow:0 24px 60px rgba(0,0,0,.45);
    --grid-line:rgba(244,238,225,.05);
  }
  @media (prefers-color-scheme: light){
    :root{
      --bg:#F4EEE1;
      --bg-2:#EDE4D0;
      --surface:rgba(11,10,8,.045);
      --surface-strong:rgba(11,10,8,.07);
      --line:rgba(11,10,8,.16);
      --text:#0B0A08;
      --muted:#5C5545;
      --card-shadow:0 24px 50px rgba(11,10,8,.14);
      --grid-line:rgba(11,10,8,.055);
    }
  }
  *{box-sizing:border-box}
  html{scroll-behavior:smooth}
  body{
    margin:0;background:var(--bg);color:var(--text);
    font-family:"Inter",system-ui,-apple-system,sans-serif;
    font-size:16px;line-height:1.6;-webkit-font-smoothing:antialiased;overflow-x:hidden;
  }
  body::before{
    content:"";position:fixed;inset:0;
    background-image:linear-gradient(var(--grid-line) 1px,transparent 1px),linear-gradient(90deg,var(--grid-line) 1px,transparent 1px);
    background-size:56px 56px;pointer-events:none;z-index:0;
  }
  .wrap{max-width:1180px;margin:0 auto;padding:0 20px;position:relative;z-index:1}
  a{color:inherit}
  button,[role="button"],a.btn,summary{min-height:44px}
  ::selection{background:var(--red);color:#fff}

  /* ---------- Nav ---------- */
  header.nav{
    position:sticky;top:0;z-index:50;
    backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);
    background:color-mix(in srgb, var(--bg) 82%, transparent);
    border-bottom:1px solid var(--line);
  }
  .nav-in{display:flex;align-items:center;gap:18px;padding:12px 0}
  .brand{display:flex;align-items:center;gap:12px;text-decoration:none;min-height:44px}
  .logo-tile{
    width:42px;height:42px;flex:0 0 42px;border-radius:10px;
    background:var(--cream);color:#0B0A08;
    display:flex;align-items:center;justify-content:center;
    font-family:"Archivo","Inter",system-ui,sans-serif;font-weight:800;font-size:22px;
    position:relative;box-shadow:inset 0 0 0 2px #0B0A08;
  }
  .logo-tile::after{content:"";position:absolute;right:5px;top:50%;transform:translateY(-50%);width:6px;height:6px;border-radius:50%;background:var(--yellow);box-shadow:0 0 0 2px #0B0A08}
  .logo-tile span{color:var(--red)}
  .brand-name{font-family:"Archivo","Inter",system-ui,sans-serif;font-weight:800;font-size:19px;letter-spacing:-.02em;line-height:1.1}
  .brand-name em{font-family:"Instrument Serif",Georgia,serif;font-style:italic;font-weight:400;color:var(--red)}
  .brand-sub{font-family:"Space Mono",ui-monospace,monospace;font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted)}
  nav.links{display:flex;gap:4px;margin-left:auto;flex-wrap:wrap}
  nav.links a{
    text-decoration:none;font-size:14px;font-weight:600;color:var(--muted);
    padding:10px 12px;border-radius:8px;display:inline-flex;align-items:center;min-height:44px;
  }
  nav.links a:hover{color:var(--text);background:var(--surface)}
  nav.links a.offer-link{color:var(--red)}
  .nav-cta{margin-left:8px}
  @media (max-width:820px){ nav.links{display:none} .nav-cta{margin-left:auto} }

  /* ---------- Buttons ---------- */
  .btn{
    display:inline-flex;align-items:center;justify-content:center;gap:9px;
    font-family:"Space Mono",ui-monospace,monospace;font-weight:700;font-size:14px;letter-spacing:.02em;
    text-decoration:none;border-radius:999px;padding:12px 22px;cursor:pointer;border:1px solid transparent;
    transition:background .18s ease,color .18s ease,border-color .18s ease,opacity .18s ease;
    min-height:48px;text-align:center;background:none;color:var(--text);
  }
  .btn-red{background:var(--red);color:#fff}
  .btn-red:hover{background:var(--red-dark)}
  .btn-cream{background:var(--cream);color:#0B0A08}
  .btn-cream:hover{background:var(--yellow)}
  .btn-yellow{background:var(--yellow);color:#0B0A08}
  .btn-yellow:hover{background:var(--cream)}
  .btn-ghost{background:transparent;color:var(--text);border-color:var(--line)}
  .btn-ghost:hover{border-color:var(--text)}
  .btn[disabled],.btn.disabled{opacity:.42;cursor:not-allowed;pointer-events:none}
  .btn svg{flex:0 0 auto}
  .btn-small{padding:9px 16px;min-height:44px;font-size:13px}

  /* ---------- Hero ---------- */
  .hero{padding:70px 0 34px;position:relative}
  .hero-glow{
    position:absolute;top:-120px;right:-140px;width:520px;height:520px;border-radius:50%;
    background:radial-gradient(circle,rgba(255,75,31,.20),rgba(242,201,76,.07) 55%,transparent 70%);
    pointer-events:none;z-index:0;
  }
  @media (prefers-color-scheme: light){ .hero-glow{background:radial-gradient(circle,rgba(255,75,31,.14),rgba(242,201,76,.06) 55%,transparent 70%)} }
  .eyebrow{
    display:inline-flex;align-items:center;gap:8px;
    font-family:"Space Mono",ui-monospace,monospace;font-size:11px;letter-spacing:.16em;text-transform:uppercase;
    border:1px solid var(--line);border-radius:999px;padding:8px 14px;color:var(--muted);background:var(--surface);
  }
  .eyebrow .dot{width:8px;height:8px;border-radius:50%;background:var(--green);flex:0 0 8px;animation:blink 2.2s ease-in-out infinite}
  @media (max-width:560px){ .eyebrow{flex-wrap:wrap;max-width:100%;line-height:1.6} }
  @keyframes blink{0%,100%{opacity:1}50%{opacity:.35}}
  h1{
    font-family:"Archivo","Inter",system-ui,sans-serif;font-weight:800;letter-spacing:-.03em;
    font-size:clamp(46px,7.5vw,86px);line-height:.97;margin:22px 0 8px;
  }
  h1 .serif{font-family:"Instrument Serif",Georgia,serif;font-style:italic;font-weight:400;color:var(--red);letter-spacing:-.01em}
  h1 .outline{
    color:transparent;-webkit-text-stroke:2px var(--text);
  }
  .hero-sub{font-size:clamp(16px,2.2vw,19px);color:var(--muted);max-width:640px;margin:14px 0 0}
  .hero-sub strong{color:var(--text)}
  .hero-cta{display:flex;gap:12px;flex-wrap:wrap;margin-top:28px}
  .hero-meta{display:flex;gap:10px;flex-wrap:wrap;margin-top:22px}
  .chip{
    font-family:"Space Mono",ui-monospace,monospace;font-size:12px;padding:8px 13px;border-radius:999px;
    border:1px solid var(--line);color:var(--muted);background:var(--surface);
    display:inline-flex;align-items:center;gap:7px;min-height:36px;
  }
  .chip b{color:var(--text);font-weight:700}
  .hero-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:44px;align-items:center;position:relative;z-index:1}
  @media (max-width:920px){ .hero-grid{grid-template-columns:1fr} }

  /* Offer callout under hero CTAs */
  .hero-offer{
    margin-top:26px;display:flex;gap:14px;align-items:center;flex-wrap:wrap;
    border:1px dashed color-mix(in srgb, var(--red) 55%, var(--line));
    background:color-mix(in srgb, var(--red) 7%, transparent);
    border-radius:14px;padding:14px 16px;max-width:640px;
  }
  .hero-offer .ho-badge{
    font-family:"Archivo","Inter",system-ui,sans-serif;font-weight:800;font-size:24px;line-height:1;
    background:var(--yellow);color:#0B0A08;border-radius:9px;padding:7px 12px;flex:0 0 auto;
  }
  .hero-offer p{margin:0;font-size:14.5px;color:var(--muted);flex:1;min-width:200px}
  .hero-offer p b{color:var(--text)}

  /* Extension mock */
  .mock{
    background:var(--bg-2);border:1px solid var(--line);border-radius:20px;
    box-shadow:var(--card-shadow);overflow:hidden;position:relative;
  }
  .mock::before{
    content:"";display:block;height:4px;
    background:linear-gradient(90deg,var(--red),var(--yellow),var(--red));
    background-size:200% 100%;animation:beam 5s linear infinite;
  }
  @keyframes beam{from{background-position:0 0}to{background-position:200% 0}}
  .mock-head{display:flex;align-items:center;gap:10px;padding:14px 16px;border-bottom:1px solid var(--line)}
  .mock-head .logo-tile{width:34px;height:34px;flex-basis:34px;font-size:17px;border-radius:8px}
  .mock-title{font-family:"Archivo","Inter",system-ui,sans-serif;font-weight:800;font-size:15px;line-height:1.15}
  .mock-title em{font-family:"Instrument Serif",Georgia,serif;font-style:italic;font-weight:400;color:var(--red)}
  .mock-ver{margin-left:auto;font-family:"Space Mono",ui-monospace,monospace;font-size:11px;color:var(--muted);border:1px solid var(--line);padding:5px 9px;border-radius:999px}
  .mock-body{padding:16px}
  .status-row{display:flex;align-items:center;gap:10px;background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:12px 14px}
  .status-dot{width:10px;height:10px;border-radius:50%;background:var(--green);flex:0 0 10px;animation:blink 2.2s ease-in-out infinite}
  .status-row .st{font-weight:600;font-size:14px}
  .status-row .sc{margin-left:auto;font-family:"Space Mono",ui-monospace,monospace;font-size:13px;color:var(--yellow)}
  @media (prefers-color-scheme: light){ .status-row .sc{color:var(--red-dark);font-weight:700} }
  .mock-label{font-family:"Space Mono",ui-monospace,monospace;font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);margin:16px 0 8px}
  .model-chain{display:flex;flex-wrap:wrap;gap:6px}
  .model-chain span{font-family:"Space Mono",ui-monospace,monospace;font-size:11px;padding:6px 10px;border-radius:999px;background:var(--surface-strong);border:1px solid var(--line)}
  .model-chain span.on{background:var(--red);border-color:var(--red);color:#fff}
  .reply-card{border:1px solid var(--line);border-radius:12px;padding:12px 14px;margin-top:8px;background:var(--surface)}
  .reply-card .who{font-size:12px;color:var(--muted);font-family:"Space Mono",ui-monospace,monospace}
  .reply-card p{margin:5px 0 0;font-size:14px}
  .reply-card .tag{display:inline-block;margin-top:8px;font-family:"Space Mono",ui-monospace,monospace;font-size:11px;color:var(--green)}
  .progress{height:8px;border-radius:99px;background:var(--surface-strong);overflow:hidden;margin-top:14px}
  .progress i{display:block;height:100%;width:70%;background:linear-gradient(90deg,var(--red),var(--yellow));border-radius:99px}

  /* Ticket marquee */
  .ticket{
    margin:46px 0 0;background:var(--yellow);color:#0B0A08;border-radius:14px;
    padding:14px 0;font-family:"Space Mono",ui-monospace,monospace;font-weight:700;font-size:13px;letter-spacing:.06em;text-transform:uppercase;
    position:relative;overflow:hidden;
  }
  .ticket-track{display:flex;gap:0;width:max-content;animation:marquee 26s linear infinite}
  .ticket-track span{padding:0 14px;white-space:nowrap}
  @keyframes marquee{from{transform:translateX(0)}to{transform:translateX(-50%)}}
  .ticket::before,.ticket::after{content:"";position:absolute;top:50%;width:22px;height:22px;border-radius:50%;background:var(--bg);transform:translateY(-50%);z-index:2}
  .ticket::before{left:-11px}.ticket::after{right:-11px}

  /* ---------- One-click download ---------- */
  .download-panel{
    margin-top:26px;background:var(--bg-2);border:1px solid var(--line);border-radius:20px;
    box-shadow:var(--card-shadow);overflow:hidden;position:relative;
  }
  .download-panel::before{
    content:"";display:block;height:4px;
    background:linear-gradient(90deg,var(--red),var(--yellow),var(--red));
    background-size:200% 100%;animation:beam 5s linear infinite;
  }
  .download-in{display:flex;align-items:center;gap:20px;flex-wrap:wrap;padding:24px 26px}
  .zip-badge{
    width:62px;height:62px;flex:0 0 62px;border-radius:14px;background:var(--yellow);color:#0B0A08;
    display:flex;flex-direction:column;align-items:center;justify-content:center;line-height:1;
    font-family:"Archivo","Inter",system-ui,sans-serif;font-weight:800;
  }
  .zip-badge b{font-size:17px;letter-spacing:.02em}
  .zip-badge span{font-family:"Space Mono",ui-monospace,monospace;font-size:9px;font-weight:700;letter-spacing:.12em;margin-top:4px}
  .download-info{flex:1;min-width:220px}
  .download-info .dl-kicker{font-family:"Space Mono",ui-monospace,monospace;font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--red);font-weight:700}
  .download-info h3{font-family:"Archivo","Inter",system-ui,sans-serif;font-size:21px;font-weight:800;margin:4px 0 4px;letter-spacing:-.01em;word-break:break-all}
  .download-info p{margin:0;color:var(--muted);font-size:14.5px}
  .download-info p b{color:var(--text)}
  .download-action{display:flex;flex-direction:column;gap:8px;align-items:stretch}
  .download-action .dl-note{font-family:"Space Mono",ui-monospace,monospace;font-size:11.5px;color:var(--muted);text-align:center}
  .download-status{font-family:"Space Mono",ui-monospace,monospace;font-size:12.5px;color:var(--green);min-height:19px;margin:0;padding:0 26px 18px}
  @media (max-width:560px){ .download-in{padding:20px} .download-action{width:100%} .download-action .btn{width:100%} }

  /* ---------- Sections ---------- */
  section{padding:74px 0 8px}
  .sec-head{max-width:720px}
  .sec-kicker{font-family:"Space Mono",ui-monospace,monospace;font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:var(--red);font-weight:700}
  h2{font-family:"Archivo","Inter",system-ui,sans-serif;font-weight:800;letter-spacing:-.025em;font-size:clamp(30px,4.6vw,44px);line-height:1.08;margin:10px 0 12px}
  h2 .serif{font-family:"Instrument Serif",Georgia,serif;font-style:italic;font-weight:400;color:var(--red)}
  .sec-sub{color:var(--muted);font-size:16.5px;margin:0}

  /* Feature list — editorial rows */
  .features{margin-top:38px;border-top:1px solid var(--line)}
  .feature{display:grid;grid-template-columns:64px 1fr 1.2fr;gap:20px;padding:26px 4px;border-bottom:1px solid var(--line);align-items:start}
  .feature .num{font-family:"Space Mono",ui-monospace,monospace;font-weight:700;color:var(--red);font-size:15px;padding-top:3px}
  .feature h3{font-family:"Archivo","Inter",system-ui,sans-serif;font-size:20px;font-weight:700;margin:0;letter-spacing:-.01em}
  .feature p{margin:0;color:var(--muted);font-size:15.5px}
  .feature p b{color:var(--text)}
  @media (max-width:700px){ .feature{grid-template-columns:40px 1fr} .feature p{grid-column:2} }

  /* System / architecture */
  .sys-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:36px}
  @media (max-width:920px){ .sys-grid{grid-template-columns:1fr} }
  .sys{border:1px solid var(--line);border-radius:16px;padding:22px;background:var(--surface)}
  .sys h3{font-family:"Archivo","Inter",system-ui,sans-serif;margin:0 0 6px;font-size:17px;font-weight:700}
  .sys .mono-tag{font-family:"Space Mono",ui-monospace,monospace;font-size:11px;color:var(--yellow);letter-spacing:.1em;text-transform:uppercase}
  @media (prefers-color-scheme: light){ .sys .mono-tag{color:var(--red-dark)} }
  .sys p{margin:8px 0 0;color:var(--muted);font-size:14.5px}
  .sys ul{margin:10px 0 0;padding:0;list-style:none}
  .sys li{font-size:14px;color:var(--muted);padding:5px 0 5px 20px;position:relative}
  .sys li::before{content:"→";position:absolute;left:0;color:var(--red);font-family:"Space Mono",ui-monospace,monospace}
  .sys li b{color:var(--text)}

  /* Steps */
  .steps{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-top:36px}
  @media (max-width:920px){ .steps{grid-template-columns:repeat(2,1fr)} }
  @media (max-width:520px){ .steps{grid-template-columns:1fr} }
  .step{border:1px solid var(--line);border-radius:16px;padding:22px;background:var(--bg-2)}
  .step .n{width:38px;height:38px;border-radius:50%;background:var(--red);color:#fff;display:flex;align-items:center;justify-content:center;font-family:"Space Mono",ui-monospace,monospace;font-weight:700;font-size:15px}
  .step h3{font-family:"Archivo","Inter",system-ui,sans-serif;font-size:17px;margin:14px 0 6px}
  .step p{margin:0;color:var(--muted);font-size:14.5px}
  .step code{font-family:"Space Mono",ui-monospace,monospace;font-size:12.5px;background:var(--surface-strong);padding:2px 7px;border-radius:6px;color:var(--text)}

  /* ---------- Pricing ---------- */
  .pricing{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-top:38px;align-items:stretch}
  @media (max-width:1020px){ .pricing{grid-template-columns:repeat(2,1fr)} }
  @media (max-width:560px){ .pricing{grid-template-columns:1fr} }
  .plan{border:1px solid var(--line);border-radius:18px;padding:26px 22px;background:var(--bg-2);display:flex;flex-direction:column;position:relative}
  .plan.hot{border-color:var(--red);box-shadow:0 0 0 1px var(--red), var(--card-shadow)}
  .plan .badge{position:absolute;top:-13px;left:22px;background:var(--yellow);color:#0B0A08;font-family:"Space Mono",ui-monospace,monospace;font-weight:700;font-size:11px;letter-spacing:.08em;text-transform:uppercase;padding:6px 12px;border-radius:999px}
  .plan .pname{font-family:"Space Mono",ui-monospace,monospace;font-size:12px;letter-spacing:.16em;text-transform:uppercase;color:var(--muted);font-weight:700}
  .plan .price{font-family:"Archivo","Inter",system-ui,sans-serif;font-weight:800;font-size:40px;letter-spacing:-.03em;margin:10px 0 2px;line-height:1}
  .plan .price small{font-size:15px;font-weight:600;color:var(--muted);letter-spacing:0}
  .plan .term{font-family:"Instrument Serif",Georgia,serif;font-style:italic;font-size:19px;color:var(--red);margin:2px 0 0}
  .plan ul{list-style:none;margin:18px 0 22px;padding:0;flex:1}
  .plan li{font-size:14.5px;color:var(--muted);padding:6px 0 6px 24px;position:relative}
  .plan li::before{content:"✓";position:absolute;left:0;color:var(--green);font-weight:700}
  .plan li.off{opacity:.55}
  .plan li.off::before{content:"—";color:var(--muted)}
  .plan .btn{width:100%}
  .price-note{margin-top:18px;color:var(--muted);font-size:14px;text-align:center}
  .price-note a{color:var(--red);font-weight:600}

  /* ---------- OFFER SYSTEM ---------- */
  .offer-panel{
    margin-top:38px;background:var(--ink);color:var(--cream);
    border:1px solid var(--line);border-radius:24px;overflow:hidden;
    box-shadow:var(--card-shadow);position:relative;
  }
  .offer-panel::before{
    content:"";display:block;height:5px;
    background:linear-gradient(90deg,var(--red),var(--yellow),var(--red));
    background-size:200% 100%;animation:beam 5s linear infinite;
  }
  .offer-grid{display:grid;grid-template-columns:330px 1fr;gap:0}
  @media (max-width:920px){ .offer-grid{grid-template-columns:1fr} }
  .offer-left{
    padding:36px 30px;border-right:1px dashed rgba(244,238,225,.25);
    display:flex;flex-direction:column;gap:16px;
    background:radial-gradient(420px 300px at 20% 0%,rgba(255,75,31,.16),transparent 65%);
  }
  @media (max-width:920px){ .offer-left{border-right:none;border-bottom:1px dashed rgba(244,238,225,.25)} }
  .offer-left .o-kicker{font-family:"Space Mono",ui-monospace,monospace;font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:var(--yellow);font-weight:700}
  .big-15{
    font-family:"Archivo","Inter",system-ui,sans-serif;font-weight:800;font-size:clamp(110px,16vw,168px);
    line-height:.9;letter-spacing:-.04em;color:var(--yellow);
    text-shadow:6px 6px 0 var(--red);
  }
  .offer-left h3{font-family:"Archivo","Inter",system-ui,sans-serif;font-size:24px;font-weight:800;margin:0;line-height:1.2;letter-spacing:-.01em}
  .offer-left h3 em{font-family:"Instrument Serif",Georgia,serif;font-style:italic;font-weight:400;color:var(--red)}
  .offer-left p{margin:0;color:#B9B09A;font-size:15px}
  .offer-reward{
    margin-top:auto;border:1px solid rgba(244,238,225,.18);border-radius:14px;padding:16px;
    background:rgba(244,238,225,.05);
  }
  .offer-reward .r-label{font-family:"Space Mono",ui-monospace,monospace;font-size:10px;letter-spacing:.16em;text-transform:uppercase;color:#B9B09A}
