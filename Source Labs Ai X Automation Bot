<script>
  (function () {
    var CLAIM_MESSAGE = 'I want to make the offer by fulfilling all the conditions.';
    var TARGET = 15;

    var writeDone = false;
    var comments = 0;

    var condWrite = document.getElementById('condWrite');
    var condComments = document.getElementById('condComments');
    var condClaim = document.getElementById('condClaim');
    var writeDoneBtn = document.getElementById('writeDoneBtn');
    var copy15Btn = document.getElementById('copy15Btn');
    var countEl = document.getElementById('commentCount');
    var commentBar = document.getElementById('commentBar');
    var plusBtn = document.getElementById('commentPlus');
    var minusBtn = document.getElementById('commentMinus');
    var resetBtn = document.getElementById('commentReset');
    var offerBar = document.getElementById('offerBar');
    var offerBarWrap = document.getElementById('offerBarWrap');
    var offerStatus = document.getElementById('offerStatus');
    var claimHint = document.getElementById('claimHint');
    var copyMsgBtn = document.getElementById('copyMsgBtn');
    var telegramBtn = document.getElementById('telegramBtn');
    var feedback = document.getElementById('offerFeedback');

    function copyText(text, okMsg) {
      function done() { feedback.textContent = okMsg; }
      function fallback() {
        var ta = document.createElement('textarea');
        ta.value = text;
        ta.style.position = 'fixed'; ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        try { document.execCommand('copy'); done(); }
        catch (err) { feedback.textContent = 'Copy it manually: ' + text; }
        document.body.removeChild(ta);
      }
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(done, fallback);
      } else { fallback(); }
    }

    function render() {
      var commentsDone = comments >= TARGET;
      var doneCount = (writeDone ? 1 : 0) + (commentsDone ? 1 : 0);

      condWrite.classList.toggle('done', writeDone);
      writeDoneBtn.setAttribute('aria-pressed', writeDone ? 'true' : 'false');
      writeDoneBtn.textContent = writeDone ? '✓ Done — tap to undo' : 'Mark as done';
      writeDoneBtn.classList.toggle('btn-done', writeDone);
      writeDoneBtn.classList.toggle('btn-outline-cream', !writeDone);

      condComments.classList.toggle('done', commentsDone);
      countEl.textContent = String(comments);
      commentBar.style.width = Math.min(100, (comments / TARGET) * 100) + '%';
      plusBtn.disabled = commentsDone;
      plusBtn.classList.toggle('disabled', commentsDone);
      minusBtn.disabled = comments === 0;
      resetBtn.disabled = comments === 0;

      offerBar.style.width = (doneCount / 2) * 100 + '%';
      offerBarWrap.setAttribute('aria-valuenow', String(doneCount));

      if (doneCount === 2) {
        offerStatus.textContent = 'All conditions complete — claim unlocked';
        condClaim.classList.remove('locked');
        condClaim.classList.add('done');
        claimHint.innerHTML = 'Both conditions are done. Copy the message below, open Telegram, paste it and send — the admin will check your Facebook comments and issue your <b>free 7-day code</b>.';
        copyMsgBtn.disabled = false;
        telegramBtn.classList.remove('disabled');
        telegramBtn.removeAttribute('aria-disabled');
        telegramBtn.removeAttribute('tabindex');
      } else {
        offerStatus.textContent = doneCount + ' of 2 conditions done';
        condClaim.classList.add('locked');
        condClaim.classList.remove('done');
        claimHint.textContent = 'This step unlocks when both Facebook conditions above are done. Then send the admin this exact message:';
        copyMsgBtn.disabled = true;
        telegramBtn.classList.add('disabled');
        telegramBtn.setAttribute('aria-disabled', 'true');
        telegramBtn.setAttribute('tabindex', '-1');
      }
    }

    writeDoneBtn.addEventListener('click', function () {
      writeDone = !writeDone;
      feedback.textContent = writeDone
        ? 'Condition 1 done — “15” is on the Facebook post.'
        : 'Condition 1 reopened.';
      render();
    });

    copy15Btn.addEventListener('click', function () {
      copyText('15', 'Copied “15” — paste it as a comment on the Facebook launch post.');
    });

    plusBtn.addEventListener('click', function () {
      if (comments < TARGET) {
        comments += 1;
        feedback.textContent = comments >= TARGET
          ? '15/15 comments — Condition 2 complete!'
          : 'Counted: ' + comments + ' of 15 comments.';
        render();
      }
    });
    minusBtn.addEventListener('click', function () {
      if (comments > 0) { comments -= 1; feedback.textContent = ''; render(); }
    });
    resetBtn.addEventListener('click', function () {
      comments = 0; feedback.textContent = 'Comment counter reset.'; render();
    });

    copyMsgBtn.addEventListener('click', function () {
      copyText(CLAIM_MESSAGE, 'Message copied — paste it in Telegram and send it to the admin.');
    });

    telegramBtn.addEventListener('click', function () {
      feedback.textContent = 'Telegram opening — paste the copied message and send it to claim your code.';
    });

    render();
  })();
</script>
<script>
  (function () {
    var bar = document.getElementById('scrollProgress');
    var header = document.querySelector('header.nav');
    function onScroll() {
      var h = document.documentElement;
      var max = h.scrollHeight - h.clientHeight;
      var p = max > 0 ? (h.scrollTop / max) * 100 : 0;
      if (bar) bar.style.width = p + '%';
      if (header) header.classList.toggle('scrolled', h.scrollTop > 8);
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var targets = document.querySelectorAll('.sec-head, .feature, .sys, .step, .plan, .offer-panel, .dev-card, .final, .faq details');
    targets.forEach(function (el, i) {
      el.classList.add('reveal');
      el.style.transitionDelay = ((i % 4) * 60) + 'ms';
    });
    if ('IntersectionObserver' in window && !reduceMotion) {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
        });
      }, { threshold: 0.1 });
      targets.forEach(function (el) { io.observe(el); });
    } else {
      targets.forEach(function (el) { el.classList.add('in'); });
    }

    var dlStatus = document.getElementById('downloadStatus');
    document.querySelectorAll('.js-download').forEach(function (a) {
      a.addEventListener('click', function () {
        if (dlStatus) dlStatus.textContent = '✓ Download started — XAutomationBot-1.1.9.zip (110 KB). Check your downloads, unzip it, then follow the Install steps below.';
      });
    });

    var cnt = document.getElementById('commentCount');
    if (cnt && 'MutationObserver' in window) {
      new MutationObserver(function () {
        var wrap = cnt.parentElement;
        if (!wrap) return;
        wrap.classList.remove('pop');
        void wrap.offsetWidth;
        wrap.classList.add('pop');
      }).observe(cnt, { childList: true });
    }
  })();
</script>
